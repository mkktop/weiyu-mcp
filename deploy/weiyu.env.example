WEIYU_ALLOWED_HOSTS=mcp.example.com,localhost,127.0.0.1
WEIYU_DATA_DIR=/var/lib/weiyu
WEIYU_ADMIN_TOKEN_FILE=/etc/weiyu/admin-token
WEIYU_COOKIE_FILE=/etc/weiyu/bilibili.cookie
WEIYU_RATE_LIMIT=2
WEIYU_MAX_CONCURRENCY=4
WEIYU_TIMEOUT_SECS=45

# 首次启动后，运行设置以 /var/lib/weiyu/settings.json 为准；
# 上面的 RATE_LIMIT / MAX_CONCURRENCY / TIMEOUT_SECS / ALLOW_WRITE 只是初始值。

# 默认 false。设为 true 后，持有访问令牌的 AI 可以点赞/投币/收藏/修改稍后再看。
# 开启前请确认 Cookie 属于专用账号，并接受真实账号被修改的风险。
WEIYU_ALLOW_WRITE=false
