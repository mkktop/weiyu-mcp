# Docker Compose 专用变量（复制为 .env 后修改）
COMPOSE_PROJECT_NAME=weiyu-mcp
# 本地构建：weiyu-mcp:0.2.1
# GHCR：ghcr.io/<owner>/weiyu-mcp:latest
WEIYU_IMAGE=weiyu-mcp:0.2.1
WEIYU_PUBLIC_HOST=mcp.example.com
# 默认只绑本机；局域网直接访问管理台/MCP 时改为 0.0.0.0（注意令牌走 HTTP 的风险）
WEIYU_BIND_ADDR=127.0.0.1
WEIYU_RATE_LIMIT=2
WEIYU_MAX_CONCURRENCY=4
WEIYU_TIMEOUT_SECS=45

# 默认 false。设为 true 后，持有访问令牌的 AI 可以点赞/投币/收藏/修改稍后再看。
WEIYU_ALLOW_WRITE=false

# 构建参数（ARM 小内存服务器建议保持 jobs=2、LTO=false）
# RUNTIME_IMAGE=gcr.io/distroless/cc-debian12:nonroot
# CARGO_BUILD_JOBS=2
# CARGO_PROFILE_RELEASE_LTO=thin
# CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
